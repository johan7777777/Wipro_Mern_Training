<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Answer</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    h1 { margin-top: 0; }
    a { color: #0066cc; margin-right: 8px; }
    textarea { width: 100%; padding: 8px; margin-bottom: 10px; border: 1px solid #ccc; box-sizing: border-box; }
    button { padding: 8px 16px; background: #333; color: #fff; border: none; cursor: pointer; }
    label { display: block; margin-bottom: 5px; }
    .error { color: red; }
  </style>
</head>
<body>
  <%- include('../partials/header') %>
  <h1>Edit Answer</h1>
  <% if (typeof error !== 'undefined' && error) { %><p class="error"><%= error %></p><% } %>
  <form method="POST" action="/answers/<%= answer.id %>/edit">
    <input type="hidden" name="returnUrl" value="/dashboard" />
    <label>Answer</label>
    <textarea name="answer" rows="5" required><%= answer ? answer.answer : '' %></textarea>
    <button type="submit">Update</button>
    <a href="/dashboard">Cancel</a>
  </form>
</body>
</html>
